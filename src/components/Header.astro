---
import site from "../data/site.json";
const { header, logoPre, logoAccent } = site;

// Current path without a trailing slash, for the active-link state.
const here = Astro.url.pathname.replace(/\/+$/, "") || "/";

// A nav item is active when it points at this page or a section of it.
// "/shop" also covers every /shop/<product> page.
const isActive = (href: string) => {
  const target = href.split("#")[0].replace(/\/+$/, "");
  if (!target) return here === "/" && !href.includes("#");
  return here === target || here.startsWith(`${target}/`);
};

// The commerce entry point is styled as a CTA so it reads as "buy", not as
// another review category.
const isShop = (href: string) => href.split("#")[0].replace(/\/+$/, "") === "/shop";
---
<header class="site-header">
  <div class="container">
    <a href="/" class="logo"><img src="/logo.png" alt="Vigorix Prime logo" class="logo-mark" />{logoPre}<span>{logoAccent}</span></a>
    <nav class="main-nav" id="main-nav" aria-label="Main">
      <ul>
        {header.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[{ cta: isShop(item.href), active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? "page" : undefined}
              set:html={item.label}
            />
          </li>
        ))}
      </ul>
    </nav>
    {/* Last in the bar, and last in the tab order too: the cart is where a
        visit ends, not where it starts. On small screens the nav collapses
        into the toggle beside it, but the cart itself never hides. */}
    <div class="header-actions">
      <button type="button" class="cart-button" data-cart-open aria-label="Open cart">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path d="M3 4h2l2.6 11.2a2 2 0 0 0 2 1.6h7.4a2 2 0 0 0 2-1.5L21 8H6"
                fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="10" cy="20" r="1.5" fill="currentColor" />
          <circle cx="18" cy="20" r="1.5" fill="currentColor" />
        </svg>
        <span class="cart-badge" data-cart-badge hidden>0</span>
        <span class="sr-only" data-cart-count-label>0 items in cart</span>
      </button>
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="main-nav">&#9776;</button>
    </div>
  </div>
</header>
