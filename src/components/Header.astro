---
import site from "../data/site.json";
const { header, logoPre, logoAccent } = site;

// Current path without a trailing slash, for the active-link state.
const here = Astro.url.pathname.replace(/\/+$/, "") || "/";

// A nav item is active when it points at this page or a section of it.
// "/shop" also covers every /shop/<product> page.
const isActive = (href: string) => {
  const target = href.split("#")[0].replace(/\/+$/, "");
  if (!target) return here === "/" && !href.includes("#");
  return here === target || here.startsWith(`${target}/`);
};

// The commerce entry point is styled as a CTA so it reads as "buy", not as
// another review category.
const isShop = (href: string) => href.split("#")[0].replace(/\/+$/, "") === "/shop";
---
<header class="site-header">
  <div class="container">
    <a href="/" class="logo"><img src="/logo.png" alt="Vigorix Prime logo" class="logo-mark" />{logoPre}<span>{logoAccent}</span></a>
    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="main-nav">&#9776;</button>
    <nav class="main-nav" id="main-nav" aria-label="Main">
      <ul>
        {header.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[{ cta: isShop(item.href), active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? "page" : undefined}
              set:html={item.label}
            />
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
