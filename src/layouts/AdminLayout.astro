---
// Shell for the Orders screens. Deliberately not BaseLayout: no shop nav, no
// cart, and never indexed — these pages show customer data.
import "../styles/global.css";
import "../styles/admin.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <title>{title}</title>
</head>
<body class="admin-body">
  <header class="ad-header">
    <div class="ad-header-inner">
      <a href="/admin/orders" class="ad-brand">Vigorix Prime <span>Orders</span></a>
      <nav class="ad-nav">
        <a href="/admin/index.html">Content CMS</a>
        <span class="ad-who" data-admin-who hidden></span>
        <button type="button" class="ad-logout" data-admin-logout hidden>Log out</button>
      </nav>
    </div>
  </header>

  <!-- Shown until a session is confirmed. The data below never renders without one. -->
  <div class="ad-gate" data-admin-gate hidden>
    <h1>Sign in to view orders</h1>
    <p class="ad-gate-note" data-gate-note>Checking your session…</p>

    <form class="ad-login" data-login-form hidden>
      <label for="gh-token">GitHub personal access token</label>
      <input
        id="gh-token"
        name="token"
        type="password"
        autocomplete="off"
        spellcheck="false"
        placeholder="ghp_… or github_pat_…"
        data-login-token
      />
      <p class="ad-login-hint">
        A token with no scopes at all is enough — it is used only to read your
        username. Create one at
        <a href="https://github.com/settings/tokens" target="_blank" rel="noopener">github.com/settings/tokens</a>.
        It is sent once, checked, and never stored.
      </p>
      <p class="ad-login-error" data-login-error role="alert" hidden></p>
      <button type="submit" class="btn btn-shop" data-login-submit>Sign in</button>
    </form>

    <p class="ad-gate-help">
      These screens show customer names, addresses and payment records. Access is
      limited to the GitHub accounts listed in <code>ADMIN_GITHUB_LOGINS</code>.
    </p>
  </div>

  <main class="ad-main" data-admin-main hidden>
    <slot />
  </main>

  <script src="/js/admin.js" is:inline></script>
</body>
</html>
